# ── SERVER ENVIRONMENT VARIABLES ─────────────────────────────
# Copy this file to .env and fill in your values

PORT=5000

# Your frontend URL — used for CORS
# Development: leave as localhost:5173 (Vite default, no change needed)
# Production:  set this to your deployed frontend URL
#              e.g. https://your-portfolio.vercel.app
# Multiple URLs: comma separated
#              e.g. https://your-portfolio.vercel.app,https://your-custom-domain.com
CLIENT_URL=http://localhost:5173

# MongoDB connection string
# Local:   mongodb://localhost:27017/YOUR_DB_NAME
# Atlas:   mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DB_NAME
MONGO_URI=your_mongodb_connection_string

# Admin panel password — you choose this, it's what you type to log in
ADMIN_PASSWORD=your_admin_password

# JWT secret — make this long and random, never share it
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key

# Resend API key — get yours free at resend.com
# Used to send contact form emails to YOUR_EMAIL_ADDRESS
RESEND_API_KEY=your_resend_api_key
